<?xml version="1.0" encoding="UTF-8" ?>
<!-- Output settings: how the book is numbered and how it looks. -->
<!-- Changing these never changes the book's content.            -->
<publication>
  <source>
    <directories generated="../generated-assets"/>
  </source>

  <numbering>
    <!-- Chapters start at 0; sections are numbered like 0.2.     -->
    <divisions chapter-start="0" level="2"/>
    <!-- Theorems, definitions, etc. are numbered like 0.2.1.     -->
    <blocks level="2"/>
    <projects level="1"/>
    <equations level="1"/>
    <footnotes level="1"/>
  </numbering>

  <common>
    <!-- End-of-section exercises: show hints and solutions, hide answers. -->
    <exercise-divisional hint="yes" answer="no" solution="yes"/>
  </common>

  <latex print="no" sides="one"/>

  <html>
    <!-- Where the website lives (used for QR codes and links). -->
    <baseurl href="https://walmsl1.github.io/analysis-book/"/>

    <!-- Website theme. "denver" draws colored boxes around theorems,   -->
    <!-- definitions, examples, etc. Other built-in themes to try:      -->
    <!-- "salem", "greeley", "boulder", "tacoma", "default-modern".     -->
    <!-- Denver/Salem accept palette="bold|bold2|primaries|primaries2|  -->
    <!-- ice-fire|earth-sea|leaves|slate" and colors via color-main,    -->
    <!-- color-fact (theorems), color-do (exercises), color-meta.       -->
    <css theme="denver"/>

    <!-- Show proofs, examples, etc. in full rather than as             -->
    <!-- click-to-expand links.                                         -->
    <knowl
      theorem="no"
      definition="no"
      remark="no"
      example="no"
      figure="no"
      table="no"
      listing="no"
      exercise-inline="no"
      exercise-divisional="no"
      project="no"
      proof="no"
    />

    <search variant="default"/>
  </html>
</publication>

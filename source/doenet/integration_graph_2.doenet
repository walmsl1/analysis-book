<setup>
  <function name="f" styleNumber="5">x*sin(x)/2 + 4</function>
  <number name="a">pi/4</number>
  <number name="b">2*pi</number>
</setup>

<graph name="g" xmin="-2" xmax="10" ymin="-2" ymax="10" displayXAxisTickLabels="false" displayYAxisTickLabels="false">
  $f
  <rectangle filled center="(pi/4+0.2708,2.315)" width="0.5146" height="4.63" styleNumber="1"/>
  <rectangle filled center="(pi/4+0.2708,2.14)" width="0.5146" height="4.28" styleNumber="2"/>
  <rectangle filled center="(1.3+1.5/2,2.455)" width="1.5" height="4.91" styleNumber="1"/>
  <rectangle filled center="(1.3+1.5/2,2.235)" width="1.5" height="4.47" styleNumber="2"/>
  <rectangle filled center="(2.8+0.7,2.235)" width="1.4" height="4.47" styleNumber="1"/>
  <rectangle filled center="(2.8+0.7,1.085)" width="1.4" height="2.17" styleNumber="2"/>
  <rectangle filled center="(4.2+pi-2.1,2)" width="2*pi-4.2" height="4" styleNumber="1"/>
  <rectangle filled center="(4.2+pi-2.1,0.795)" width="2*pi-4.2" height="1.59" styleNumber="2"/>
  <text anchor="($a,-0.5)"><math>t_0</math></text>
  <text anchor="(1.3,-0.5)"><math>t_1</math></text>
  <text anchor="(2.8,-0.5)"><math>t_2</math></text>
  <text anchor="(4.2,-0.5)"><math>t_3</math></text>
  <text anchor="($b,-0.5)"><math>t_4</math></text>
</graph>
The function <m>f(x)=3x+5</m> is graphed below. The horizontal lines are <m>y=f(a)\pm\epsilon</m> and the vertical lines are <m>x=a\pm\delta</m>.

<setup> <function name="f" symbolic> 3x+5 </function> </setup>
<!-- Pick x-value for point of interest -->
<p>Choose a value for <m>a</m> (or adjust slider): <m>a = </m> <mathInput name="a" bindValueTo="$aSlider"/>
<slider from="-2" to="2" step="0.01" name="aSlider" initialValue="1" />
</p>
<!-- Pick value for epsilon -->
<p>Choose a value of <m>\epsilon</m> (or adjust slider): <m>\epsilon = </m> <mathInput name="eps" bindValueTo="$epsSlider"/></p>

<slider from="0" to="2" step="0.001" name="epsSlider" initialValue="1" />

<!-- Defining the point on which to focus -->
<setup>
  <point name="P">($a,$$f($a))</point>
  <number name="Py" fixed > $P.y </number>
  <number name="Px" fixed > $P.x </number>
</setup>

<!-- Graphing f and the epsilon-delta "window" -->
<setup>
 <graph name ="g" xmin="-3" xmax="3" ymin="-4" ymax="14">
 $f
 $P
 <line styleNumber="4" through="(1,$Py+$eps) (2,$Py+$eps)" />
 <line styleNumber="4" through="(1,$Py-$eps) (2,$Py-$eps)" />
 <line styleNumber="6" through="($Px-$delta,1) ($Px-$delta,2)" />
 <line styleNumber="6" through="($Px+$delta,1) ($Px+$delta,2)" />
 </graph>
</setup>

<sideBySide>
 <subsection>
    <title>Initial graph</title>
    <graph extend="$g" name="zoomedOut" >
    </graph>
  </subsection>
  <subsection>
    <title>Zoomed graph</title>
    <graph extend="$g"
      xmin="$a-2*$delta"
      xmax="$a+2*$delta"
      ymin="$$f($a)-2*$eps"
      ymax="$$f($a)+2*$eps"
      >
      </graph>
  </subsection>
</sideBySide>


<p>Choose a value of <m>\delta</m> (or adjust slider): <m>\delta = </m> <mathInput name="delta" bindValueTo="$deltaSlider"/></p>

<slider from="0" to="2" step="0.00001" name="deltaSlider" initialValue="0.5" />

<!-- Epsilon is given first; the student answers with delta.                  -->
<!-- A delta is accepted when it is positive and the largest value of         -->
<!-- |f(x)-f(a)| on [a-delta, a+delta] is at most epsilon. The tiny allowance  -->
<!-- (10^-9) absorbs rounding, so the exact answer delta = epsilon/3 passes.   -->
<problem>
<p> Set <m>a=1</m>, so the point <m>(a,f(a))=(1,8)</m> is plotted on the graph. For each value of <m> \epsilon </m> given below, use the graphs to find a value of <m>\delta\gt 0</m> such that for all <m>x</m> with <m>|x-a|\lt\delta</m>, <m>|f(x)-f(a)|\lt\epsilon</m>.</p>

  <setup>
   <number name="eps1">1 </number>
    <number name="eps2">0.1 </number>
    <number name="eps3">0.01 </number>
  </setup>

 <tabular topBorder="minor" bottomBorder="minor">
    <row>
      <cell> <m>\epsilon=$eps1</m> </cell>
      <cell><m> \delta = </m><mathInput name="delta1" /></cell>
      <answer>
  <award>
    <when>
      $delta1 > 0 and $max1 <= $eps1 + 0.000000001
    </when>
  </award>
</answer>
    </row>
    <row>
      <cell> <m>\epsilon=$eps2</m> </cell>
      <cell><m> \delta = </m><mathInput name="delta2" /></cell>
      <answer>
  <award>
    <when>
      $delta2 > 0 and $max2 <= $eps2 + 0.000000001
    </when>
  </award>
</answer>
    </row>
    <row>
      <cell> <m>\epsilon=$eps3</m> </cell>
      <cell><m> \delta = </m><mathInput name="delta3" /></cell>
      <answer>
  <award>
    <when>
      $delta3 > 0 and $max3 <= $eps3 + 0.000000001
    </when>
  </award>
</answer>
    </row>
  </tabular>

<setup>
 <function name="check1" domain="[$a-$delta1,$a+$delta1]"><abs>
 $f-$$f($a) </abs> </function>
  <number name="max1"><max>$$check1($a-$delta1) $check1.maximumValues $$check1($a+$delta1)</max></number>

  <function name="check2" domain="[$a-$delta2,$a+$delta2]"><abs>
 $f-$$f($a) </abs> </function>
  <number name="max2"><max>$$check2($a-$delta2) $check2.maximumValues $$check2($a+$delta2)</max></number>

  <function name="check3" domain="[$a-$delta3,$a+$delta3]"><abs>
 $f-$$f($a) </abs> </function>
  <number name="max3"><max>$$check3($a-$delta3) $check3.maximumValues $$check3($a+$delta3)</max></number>
</setup>


</problem>
